rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'chanderstudio0@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500000)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500000)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 100)) &&
             (!('portfolioLinks' in data) || (data.portfolioLinks is list && data.portfolioLinks.size() <= 10)) &&
             (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('role' in data) || (data.role is string && (data.role == 'user' || data.role == 'admin'))) &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512)) &&
             (!('fcmTokenUpdatedAt' in data) || (data.fcmTokenUpdatedAt is timestamp && data.fcmTokenUpdatedAt <= request.time)) &&
             (!('announcementsOptIn' in data) || data.announcementsOptIn is bool) &&
             (!('appointmentPushOptIn' in data) || data.appointmentPushOptIn is bool) &&
             (!('favoritePackageIds' in data) || (data.favoritePackageIds is list && data.favoritePackageIds.size() <= 30)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidPortfolioPhotoItem(item) {
      return item is string && item.size() > 0 && item.size() <= 150000;
    }

    function isValidPortfolioPhotosList(photos) {
      return photos is list &&
             photos.size() <= 4 &&
             (photos.size() < 1 || isValidPortfolioPhotoItem(photos[0])) &&
             (photos.size() < 2 || isValidPortfolioPhotoItem(photos[1])) &&
             (photos.size() < 3 || isValidPortfolioPhotoItem(photos[2])) &&
             (photos.size() < 4 || isValidPortfolioPhotoItem(photos[3]));
    }

    function isValidModel(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             (!('dateOfBirth' in data) || (data.dateOfBirth is string && data.dateOfBirth.size() <= 20)) &&
             data.age is int && data.age >= 18 && data.age <= 100 &&
             (!('gender' in data) || (data.gender is string && data.gender.size() <= 50)) &&
             data.city is string && data.city.size() > 0 && data.city.size() <= 100 &&
             (!('state' in data) || (data.state is string && data.state.size() <= 60)) &&
             (!('heightCm' in data) || (data.heightCm is int && data.heightCm >= 120 && data.heightCm <= 230)) &&
             (!('languages' in data) || (data.languages is string && data.languages.size() <= 300)) &&
             (!('experienceLevel' in data) || (data.experienceLevel is string && data.experienceLevel.size() <= 40)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 128)) &&
             data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20 &&
             (!('skills' in data) || (data.skills is string && data.skills.size() <= 1000)) &&
             (!('portfolioUrls' in data) || (data.portfolioUrls is string && data.portfolioUrls.size() <= 2000)) &&
             (!('portfolioPhotos' in data) || isValidPortfolioPhotosList(data.portfolioPhotos)) &&
             (!('introVideoUrl' in data) || (data.introVideoUrl is string && data.introVideoUrl.size() <= 2000)) &&
             (!('photoConsent' in data) || data.photoConsent is bool) &&
             (!('isDisabled' in data) || data.isDisabled is bool) &&
             data.consentGiven == true &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidBooking(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
             data.contactNumber is string && data.contactNumber.size() >= 8 && data.contactNumber.size() <= 20 &&
             data.serviceType is string && data.serviceType.size() > 0 && data.serviceType.size() <= 100 &&
             data.preferredDate is string && data.preferredDate.size() > 0 && data.preferredDate.size() <= 50 &&
             (!('preferredTime' in data) || (data.preferredTime is string && data.preferredTime.size() <= 50)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             data.status in ['Pending', 'Approved', 'Rejected', 'Confirmed', 'Completed', 'Cancelled'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidGallery(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.category is string && data.category.size() <= 60 &&
             data.mediaType in ['photo', 'video'] &&
             data.mediaUrl is string && data.mediaUrl.size() > 0 && data.mediaUrl.size() <= 850000 &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 200000)) &&
             data.isDemo is bool &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidBlogPost(data) {
      return data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             data.category in ['Studio News', 'Photography Tips', 'Behind The Scenes', 'Gear & Lighting', 'Model Spotlight'] &&
             data.content is string && data.content.size() >= 10 && data.content.size() <= 20000 &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000)) &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             (!('tags' in data) || (data.tags is string && data.tags.size() <= 200)) &&
             data.status in ['published', 'draft'] &&
             (!('readTimeMinutes' in data) || (data.readTimeMinutes is int && data.readTimeMinutes >= 1 && data.readTimeMinutes <= 60)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidReview(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.bookingId is string && data.bookingId.size() > 0 && data.bookingId.size() <= 128 &&
             data.reviewerName is string && data.reviewerName.size() >= 2 && data.reviewerName.size() <= 100 &&
             (!('reviewerAvatarUrl' in data) || (data.reviewerAvatarUrl is string && data.reviewerAvatarUrl.size() <= 500000)) &&
             data.serviceType is string && data.serviceType.size() > 0 && data.serviceType.size() <= 100 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidAnnouncement(data) {
      return data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
             data.category in ['Studio Update', 'Casting Call', 'Offer & Discount', 'Schedule Alert', 'Workshop & Gear'] &&
             data.priority in ['normal', 'urgent'] &&
             (!('targetTopic' in data) || (data.targetTopic is string && data.targetTopic.size() <= 100)) &&
             (!('actionRoute' in data) || (data.actionRoute in ['home', 'bookings', 'catalog', 'portfolio', 'models'])) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidAppointmentNotification(data, userId) {
      return data.userId == userId &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.bookingId is string && data.bookingId.size() > 0 && data.bookingId.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
             data.message is string && data.message.size() >= 3 && data.message.size() <= 2000 &&
              data.status in ['Pending', 'Confirmed', 'Completed', 'Cancelled', 'Rescheduled', 'Approved', 'Rejected', 'Disabled'] &&
              (!('serviceType' in data) || (data.serviceType is string && data.serviceType.size() <= 120)) &&
              (!('targetFcmToken' in data) || (data.targetFcmToken is string && data.targetFcmToken.size() <= 512)) &&
              data.isRead is bool &&
              (!('channelType' in data) || (data.channelType is string && data.channelType.size() <= 60)) &&
              data.createdAt is timestamp && data.createdAt <= request.time &&
              (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidPublicModel(data) {
      return data.keys().hasOnly([
               'modelId', 'fullName', 'gender', 'age', 'city', 'state', 'heightCm',
               'languages', 'experienceLevel', 'skills', 'bio', 'portfolioUrl',
               'portfolioPhotos', 'introVideoUrl', 'portfolioAvailable',
               'photoConsent', 'avatarUrl', 'category', 'isOfficialRoster',
               'createdAt', 'updatedAt'
             ]) &&
             data.modelId is string && data.modelId.size() > 0 && data.modelId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             (!('gender' in data) || (data.gender is string && data.gender.size() <= 50)) &&
             (!('age' in data) || (data.age is int && data.age >= 18 && data.age <= 100)) &&
             data.city is string && data.city.size() > 0 && data.city.size() <= 100 &&
             (!('state' in data) || (data.state is string && data.state.size() <= 60)) &&
             (!('heightCm' in data) || (data.heightCm is int && data.heightCm >= 120 && data.heightCm <= 230)) &&
             (!('languages' in data) || (data.languages is string && data.languages.size() <= 300)) &&
             (!('experienceLevel' in data) || (data.experienceLevel is string && data.experienceLevel.size() <= 40)) &&
             (!('skills' in data) || (data.skills is string && data.skills.size() <= 1000)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('portfolioUrl' in data) || (data.portfolioUrl is string && data.portfolioUrl.size() <= 2000)) &&
             (!('portfolioPhotos' in data) || isValidPortfolioPhotosList(data.portfolioPhotos)) &&
             (!('introVideoUrl' in data) || (data.introVideoUrl is string && data.introVideoUrl.size() <= 2000)) &&
             (!('portfolioAvailable' in data) || data.portfolioAvailable is bool) &&
             (!('photoConsent' in data) || data.photoConsent is bool) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 150000)) &&
             ((!('portfolioPhotos' in data) || data.portfolioPhotos.size() == 0) || (!('avatarUrl' in data) || data.avatarUrl == '')) &&
             ((('photoConsent' in data) && data.photoConsent == true) ||
               ((!('portfolioPhotos' in data) || data.portfolioPhotos.size() == 0) && (!('avatarUrl' in data) || data.avatarUrl == ''))) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
             data.isOfficialRoster == true &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCompany(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 120 &&
             (!('organizationType' in data) || (data.organizationType in ['Company', 'Event Organizer', 'Brand / Agency', 'Production House', 'Verified Content Creator', 'Wedding Planner', 'Other'])) &&
             data.contactPerson is string && data.contactPerson.size() >= 2 && data.contactPerson.size() <= 100 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 8 && data.mobileNumber.size() <= 20 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 128 && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
             data.address is string && data.address.size() >= 5 && data.address.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCompanyBooking(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 120 &&
             (!('organizationType' in data) || (data.organizationType in ['Company', 'Event Organizer', 'Brand / Agency', 'Production House', 'Verified Content Creator', 'Wedding Planner', 'Other'])) &&
             data.contactPerson is string && data.contactPerson.size() >= 2 && data.contactPerson.size() <= 100 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 8 && data.mobileNumber.size() <= 20 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 128 && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
             data.address is string && data.address.size() >= 5 && data.address.size() <= 300 &&
             data.modelRequirement in ['Male Models', 'Female Models', 'Both', 'Multiple Models'] &&
             data.modelsCount is int && data.modelsCount >= 1 && data.modelsCount <= 200 &&
             data.eventType in ['Fashion Show', 'Wedding', 'Music Video', 'Advertisement', 'Brand Promotion', 'Photoshoot', 'Other'] &&
             data.eventDate is string && data.eventDate.size() >= 6 && data.eventDate.size() <= 50 &&
             data.eventLocation is string && data.eventLocation.size() >= 2 && data.eventLocation.size() <= 200 &&
             data.budget is string && data.budget.size() >= 2 && data.budget.size() <= 80 &&
             data.detailedRequirements is string && data.detailedRequirements.size() >= 10 && data.detailedRequirements.size() <= 2000 &&
             (!('requestedModelIds' in data) || (data.requestedModelIds is list && data.requestedModelIds.size() <= 20)) &&
             (!('requestedModelNames' in data) || (data.requestedModelNames is list && data.requestedModelNames.size() <= 20)) &&
             data.status in ['Pending', 'Approved', 'Contacted', 'Completed', 'Rejected', 'Cancelled'] &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidAdminEmailTest(data) {
      return data.requestedByUid == request.auth.uid &&
             data.requestedByEmail is string &&
             data.requestedByEmail.lower() == 'chanderstudio0@gmail.com' &&
             data.recipientEmail is string &&
             data.recipientEmail.lower() == 'chanderstudio0@gmail.com' &&
             data.templateType in ['booking', 'model', 'company'] &&
             data.status == 'queued' &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             (!('recordId' in data) || (data.recordId is string && data.recordId.size() <= 128)) &&
             (!('isSample' in data) || data.isSample is bool) &&
             (!('recordSnapshot' in data) || data.recordSnapshot is map) &&
             (!('templateOverrides' in data) || data.templateOverrides is map) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidServicePackageConfig(data, packageId) {
      return packageId in ['wedding_basic', 'wedding_premium', 'wedding_luxury'] &&
             data.keys().hasOnly([
               'tierId', 'tierNameEn', 'tierNameHi', 'priceInr', 'durationEn',
               'turnaroundEn', 'includedServices', 'updatedByEmail', 'updatedAt'
             ]) &&
             data.tierId == packageId &&
             data.tierNameEn is string && data.tierNameEn.size() >= 2 && data.tierNameEn.size() <= 100 &&
             (!('tierNameHi' in data) || (data.tierNameHi is string && data.tierNameHi.size() <= 100)) &&
             data.priceInr is int && data.priceInr >= 1000 && data.priceInr <= 10000000 &&
             data.durationEn is string && data.durationEn.size() >= 2 && data.durationEn.size() <= 100 &&
             data.turnaroundEn is string && data.turnaroundEn.size() >= 2 && data.turnaroundEn.size() <= 100 &&
             data.includedServices is list && data.includedServices.size() >= 1 && data.includedServices.size() <= 15 &&
             (!('updatedByEmail' in data) || (data.updatedByEmail is string && data.updatedByEmail.lower() == 'chanderstudio0@gmail.com')) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudioEmailConfig(data, configId) {
      return configId == 'emailAlerts' &&
             data.keys().hasOnly([
               'bookingAlertsEnabled', 'modelAlertsEnabled', 'companyAlertsEnabled',
               'browserAlertsEnabled', 'recipientEmail', 'updatedByEmail', 'updatedAt'
             ]) &&
             data.bookingAlertsEnabled is bool &&
             data.modelAlertsEnabled is bool &&
             (!('companyAlertsEnabled' in data) || data.companyAlertsEnabled is bool) &&
             (!('browserAlertsEnabled' in data) || data.browserAlertsEnabled is bool) &&
             data.recipientEmail is string &&
             data.recipientEmail.lower() == 'chanderstudio0@gmail.com' &&
             (!('updatedByEmail' in data) || (data.updatedByEmail is string && data.updatedByEmail.lower() == 'chanderstudio0@gmail.com')) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminEmailAlert(data) {
      return data.keys().hasOnly([
               'type', 'recordId', 'recipientEmail', 'subject', 'summary',
               'status', 'source', 'messageId', 'errorMessage', 'isRead',
               'createdAt', 'updatedAt'
             ]) &&
             data.type in ['booking', 'model', 'company'] &&
             data.recordId is string && data.recordId.size() > 0 && data.recordId.size() <= 128 &&
             data.recipientEmail is string &&
             data.recipientEmail.lower() == 'chanderstudio0@gmail.com' &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 500)) &&
             data.status in ['queued', 'sent', 'failed', 'skipped', 'acknowledged'] &&
             (!('source' in data) || data.source in ['cloud-function', 'dashboard-live', 'manual-resend']) &&
             (!('messageId' in data) || (data.messageId is string && data.messageId.size() <= 200)) &&
             (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 300)) &&
             (!('isRead' in data) || data.isRead is bool) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isChatBlocked(uid) {
      return exists(/databases/$(database)/documents/chatBlockedUsers/$(uid)) &&
             get(/databases/$(database)/documents/chatBlockedUsers/$(uid)).data.isBlocked == true;
    }

    function isValidProfessionalProfile(data) {
      return data.keys().hasOnly([
               'userId', 'fullName', 'mobileNumber', 'email', 'city', 'state',
               'category', 'yearsExperience', 'skills', 'equipmentDetails',
               'workingLocations', 'expectedCharges', 'portfolioPhotos',
               'videoLinks', 'shortIntro', 'availabilityStatus',
               'status', 'adminNotes', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 8 && data.mobileNumber.size() <= 20 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 128 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.state is string && data.state.size() >= 2 && data.state.size() <= 80 &&
             data.category in ['Photographer', 'Videographer', 'Editor', 'Camera Operator', 'Drone Operator', 'Hybrid (Photo + Video)'] &&
             data.yearsExperience is int && data.yearsExperience >= 0 && data.yearsExperience <= 60 &&
             data.skills is string && data.skills.size() >= 2 && data.skills.size() <= 500 &&
             data.equipmentDetails is string && data.equipmentDetails.size() >= 2 && data.equipmentDetails.size() <= 600 &&
             data.workingLocations is string && data.workingLocations.size() >= 2 && data.workingLocations.size() <= 300 &&
             (!('expectedCharges' in data) || (data.expectedCharges is string && data.expectedCharges.size() <= 120)) &&
             (!('portfolioPhotos' in data) || (data.portfolioPhotos is list && data.portfolioPhotos.size() <= 4)) &&
             (!('videoLinks' in data) || (data.videoLinks is string && data.videoLinks.size() <= 1000)) &&
             data.shortIntro is string && data.shortIntro.size() >= 10 && data.shortIntro.size() <= 1000 &&
             data.availabilityStatus in ['Available', 'Limited Availability', 'Busy / Booked'] &&
             data.status in ['pending', 'approved', 'rejected', 'suspended'] &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPublicProfessionalProfile(data, professionalId) {
      return data.keys().hasOnly([
               'professionalId', 'fullName', 'city', 'state', 'category',
               'yearsExperience', 'skills', 'equipmentDetails', 'workingLocations',
               'expectedCharges', 'portfolioPhotos', 'videoLinks', 'shortIntro',
               'availabilityStatus', 'verifiedBadge', 'createdAt', 'updatedAt'
             ]) &&
             data.professionalId == professionalId &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.state is string && data.state.size() >= 2 && data.state.size() <= 80 &&
             data.category in ['Photographer', 'Videographer', 'Editor', 'Camera Operator', 'Drone Operator', 'Hybrid (Photo + Video)'] &&
             data.yearsExperience is int && data.yearsExperience >= 0 && data.yearsExperience <= 60 &&
             data.skills is string && data.skills.size() <= 500 &&
             data.equipmentDetails is string && data.equipmentDetails.size() <= 600 &&
             data.workingLocations is string && data.workingLocations.size() <= 300 &&
             (!('expectedCharges' in data) || (data.expectedCharges is string && data.expectedCharges.size() <= 120)) &&
             (!('portfolioPhotos' in data) || (data.portfolioPhotos is list && data.portfolioPhotos.size() <= 4)) &&
             (!('videoLinks' in data) || (data.videoLinks is string && data.videoLinks.size() <= 1000)) &&
             data.shortIntro is string && data.shortIntro.size() <= 1000 &&
             data.availabilityStatus in ['Available', 'Limited Availability', 'Busy / Booked'] &&
             data.verifiedBadge == true &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProfessionalHiringRequest(data) {
      return data.keys().hasOnly([
               'userId', 'customerName', 'contactNumber', 'eventType', 'requiredService',
               'eventDate', 'eventTime', 'eventLocation', 'workingDuration', 'budgetRange',
               'specialRequirements', 'referenceLinks', 'referencePhotos',
               'status', 'assignedProfessionalId', 'assignedProfessionalUid',
               'assignedProfessionalName', 'assignedProfessionalCategory',
               'proposalMessage', 'customerAcceptance', 'customerResponseNote',
               'adminNotes', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
             data.contactNumber is string && data.contactNumber.size() >= 8 && data.contactNumber.size() <= 20 &&
             data.eventType in ['Wedding', 'Pre-wedding', 'Birthday', 'Party', 'Corporate', 'Music Video', 'Modeling', 'Other'] &&
             data.requiredService in ['Photography', 'Videography', 'Both', 'Drone', 'Editing'] &&
             data.eventDate is string && data.eventDate.size() >= 8 && data.eventDate.size() <= 30 &&
             data.eventTime is string && data.eventTime.size() >= 2 && data.eventTime.size() <= 30 &&
             data.eventLocation is string && data.eventLocation.size() >= 2 && data.eventLocation.size() <= 200 &&
             data.workingDuration is string && data.workingDuration.size() >= 1 && data.workingDuration.size() <= 80 &&
             data.budgetRange is string && data.budgetRange.size() >= 2 && data.budgetRange.size() <= 100 &&
             (!('specialRequirements' in data) || (data.specialRequirements is string && data.specialRequirements.size() <= 1500)) &&
             (!('referenceLinks' in data) || (data.referenceLinks is string && data.referenceLinks.size() <= 1000)) &&
             (!('referencePhotos' in data) || (data.referencePhotos is list && data.referencePhotos.size() <= 3)) &&
             data.status in [
               'Pending Admin Review', 'Assignment Proposed', 'Customer Accepted',
               'Proposal Declined', 'Confirmed', 'Assigned', 'In Progress',
               'Completed', 'Cancelled', 'Rejected'
             ] &&
             (!('assignedProfessionalId' in data) || (data.assignedProfessionalId is string && data.assignedProfessionalId.size() <= 128)) &&
             (!('assignedProfessionalUid' in data) || (data.assignedProfessionalUid is string && data.assignedProfessionalUid.size() <= 128)) &&
             (!('assignedProfessionalName' in data) || (data.assignedProfessionalName is string && data.assignedProfessionalName.size() <= 100)) &&
             (!('assignedProfessionalCategory' in data) || (data.assignedProfessionalCategory is string && data.assignedProfessionalCategory.size() <= 60)) &&
             (!('proposalMessage' in data) || (data.proposalMessage is string && data.proposalMessage.size() <= 1000)) &&
             data.customerAcceptance in ['pending', 'accepted', 'declined'] &&
             (!('customerResponseNote' in data) || (data.customerResponseNote is string && data.customerResponseNote.size() <= 500)) &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidOutsourcingRequest(data) {
      return data.keys().hasOnly([
               'userId', 'studioOrName', 'contactInfo', 'city', 'workType',
               'projectDescription', 'workDeadline', 'budget', 'referenceLinks',
               'referencePhotos', 'additionalMessage', 'status',
               'assignedProfessionalId', 'assignedProfessionalUid',
               'assignedProfessionalName', 'adminNotes', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.studioOrName is string && data.studioOrName.size() >= 2 && data.studioOrName.size() <= 120 &&
             data.contactInfo is string && data.contactInfo.size() >= 6 && data.contactInfo.size() <= 120 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.workType in ['Photography', 'Videography', 'Video Editing', 'Album Design', 'Drone Shooting', 'Full Production', 'Other'] &&
             data.projectDescription is string && data.projectDescription.size() >= 10 && data.projectDescription.size() <= 2000 &&
             data.workDeadline is string && data.workDeadline.size() >= 6 && data.workDeadline.size() <= 40 &&
             (!('budget' in data) || (data.budget is string && data.budget.size() <= 100)) &&
             (!('referenceLinks' in data) || (data.referenceLinks is string && data.referenceLinks.size() <= 1000)) &&
             (!('referencePhotos' in data) || (data.referencePhotos is list && data.referencePhotos.size() <= 3)) &&
             (!('additionalMessage' in data) || (data.additionalMessage is string && data.additionalMessage.size() <= 1000)) &&
             data.status in ['Pending Admin Review', 'Approved', 'Assigned', 'In Progress', 'Completed', 'Rejected', 'Cancelled'] &&
             (!('assignedProfessionalId' in data) || (data.assignedProfessionalId is string && data.assignedProfessionalId.size() <= 128)) &&
             (!('assignedProfessionalUid' in data) || (data.assignedProfessionalUid is string && data.assignedProfessionalUid.size() <= 128)) &&
             (!('assignedProfessionalName' in data) || (data.assignedProfessionalName is string && data.assignedProfessionalName.size() <= 100)) &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPrivateChatThread(data) {
      return data.keys().hasOnly([
               'participantUid', 'participantName', 'participantEmail', 'participantRole',
               'contextType', 'contextId', 'contextLabel',
               'lastMessageText', 'lastMessageAt', 'lastSenderRole',
               'unreadByAdmin', 'unreadByUser', 'createdAt', 'updatedAt'
             ]) &&
             data.participantUid is string && data.participantUid.size() > 0 && data.participantUid.size() <= 128 &&
             data.participantName is string && data.participantName.size() >= 1 && data.participantName.size() <= 100 &&
             (!('participantEmail' in data) || (data.participantEmail is string && data.participantEmail.size() <= 128)) &&
             data.participantRole in ['customer', 'professional'] &&
             data.contextType in ['hiring', 'professional', 'outsourcing', 'general'] &&
             (!('contextId' in data) || (data.contextId is string && data.contextId.size() <= 128)) &&
             data.contextLabel is string && data.contextLabel.size() >= 1 && data.contextLabel.size() <= 160 &&
             (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
             (!('lastMessageAt' in data) || (data.lastMessageAt is timestamp && data.lastMessageAt <= request.time)) &&
             (!('lastSenderRole' in data) || data.lastSenderRole in ['customer', 'professional', 'admin']) &&
             data.unreadByAdmin is int && data.unreadByAdmin >= 0 && data.unreadByAdmin <= 10000 &&
             data.unreadByUser is int && data.unreadByUser >= 0 && data.unreadByUser <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPrivateChatMessage(data) {
      return data.keys().hasOnly([
               'chatId', 'senderUid', 'senderName', 'senderRole',
               'text', 'imageAttachment', 'createdAt',
               'isRead', 'readAt', 'readByUid', 'readByRole'
             ]) &&
             data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 140 &&
             data.senderUid is string && data.senderUid.size() > 0 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
             data.senderRole in ['customer', 'professional', 'admin'] &&
             data.text is string && data.text.size() <= 2000 &&
             (!('imageAttachment' in data) || (data.imageAttachment is string && data.imageAttachment.size() <= 180000)) &&
             (data.text.size() > 0 || ('imageAttachment' in data && data.imageAttachment.size() > 0)) &&
             (!('isRead' in data) || data.isRead is bool) &&
             (!('readAt' in data) || (data.readAt is timestamp && data.readAt <= request.time)) &&
             (!('readByUid' in data) || (data.readByUid is string && data.readByUid.size() <= 128)) &&
             (!('readByRole' in data) || data.readByRole in ['customer', 'professional', 'admin']) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChatBlockedUser(data, userId) {
      return data.keys().hasOnly(['userId', 'isBlocked', 'reason', 'updatedByEmail', 'updatedAt']) &&
             data.userId == userId &&
             data.isBlocked is bool &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 300)) &&
             data.updatedByEmail is string && data.updatedByEmail.lower() == 'chanderstudio0@gmail.com' &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCustomerCatalog(data) {
      return data.keys().hasOnly([
               'customerUid', 'bookingId', 'title', 'description', 'category',
               'items', 'coverImageUrl', 'sharedByAdminEmail', 'status',
               'createdAt', 'updatedAt'
             ]) &&
             data.customerUid is string && data.customerUid.size() > 0 && data.customerUid.size() <= 128 &&
             (!('bookingId' in data) || (data.bookingId is string && data.bookingId.size() <= 128)) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 80)) &&
             (!('items' in data) || (data.items is list && data.items.size() <= 50)) &&
             (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 180000)) &&
             data.sharedByAdminEmail is string && data.sharedByAdminEmail.lower() == 'chanderstudio0@gmail.com' &&
             data.status in ['active', 'archived'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCustomerSlot(data) {
      return data.keys().hasOnly([
               'customerUid', 'bookingId', 'eventTitle', 'eventDate', 'eventTime',
               'slotLabel', 'location', 'approvalStatus', 'customerNote',
               'assignedByAdminEmail', 'createdAt', 'updatedAt'
             ]) &&
             data.customerUid is string && data.customerUid.size() > 0 && data.customerUid.size() <= 128 &&
             (!('bookingId' in data) || (data.bookingId is string && data.bookingId.size() <= 128)) &&
             data.eventTitle is string && data.eventTitle.size() >= 2 && data.eventTitle.size() <= 140 &&
             data.eventDate is string && data.eventDate.size() >= 6 && data.eventDate.size() <= 50 &&
             data.eventTime is string && data.eventTime.size() >= 2 && data.eventTime.size() <= 50 &&
             data.slotLabel is string && data.slotLabel.size() >= 2 && data.slotLabel.size() <= 120 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             data.approvalStatus in ['Pending', 'Approved', 'Rejected', 'Confirmed'] &&
             (!('customerNote' in data) || (data.customerNote is string && data.customerNote.size() <= 500)) &&
             data.assignedByAdminEmail is string && data.assignedByAdminEmail.lower() == 'chanderstudio0@gmail.com' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       (!('role' in incoming()) || incoming().role == 'user' || isAdmin()) &&
                       isValidUser(incoming());
      allow update: if isSignedIn() && (
                       isAdmin() ||
                       (request.auth.uid == userId && incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt &&
                        (!('role' in incoming()) || incoming().role == existing().role) &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'displayName', 'photoUrl', 'avatarUrl',
                          'phoneNumber', 'city', 'instagramHandle', 'portfolioLinks', 'specialty', 'bio',
                          'fcmToken', 'fcmTokenUpdatedAt', 'announcementsOptIn', 'appointmentPushOptIn',
                          'favoritePackageIds', 'updatedAt'
                        ]))
                     ) && isValidUser(incoming());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      match /history/{historyId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /notifications/{notificationId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isValidId(notificationId) &&
                         (isAdmin() || (isSignedIn() && request.auth.uid == userId)) &&
                         isValidAppointmentNotification(incoming(), userId);
        allow update: if isValidId(notificationId) && (
                         isAdmin() ||
                         (isSignedIn() && request.auth.uid == userId &&
                          incoming().userId == existing().userId &&
                          incoming().bookingId == existing().bookingId &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']))
                       ) && isValidAppointmentNotification(incoming(), userId);
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /models/{modelId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       (!('isDisabled' in incoming()) || incoming().isDisabled == false) &&
                       isValidModel(incoming());
      allow update: if isSignedIn() && (
                       isAdmin() ||
                       (resource.data.userId == request.auth.uid &&
                        incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().status == existing().status &&
                        (!('isDisabled' in incoming()) || ('isDisabled' in existing() && incoming().isDisabled == existing().isDisabled) || incoming().isDisabled == false) &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'fullName', 'gender', 'dateOfBirth', 'age', 'city', 'state',
                          'heightCm', 'skills', 'languages', 'experienceLevel', 'bio',
                          'portfolioUrls', 'portfolioPhotos', 'introVideoUrl',
                          'contactEmail', 'phoneNumber', 'photoConsent', 'updatedAt'
                        ]))
                     ) && isValidModel(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Privacy-safe member portfolio showcase of approved models (requires Firebase Auth; strictly excludes personal phone/email)
    match /publicModels/{modelId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidPublicModel(incoming());
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow get: if isSignedIn() && (request.auth.uid == companyId || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.auth.uid == companyId &&
                       incoming().userId == request.auth.uid &&
                       isValidCompany(incoming());
      allow update: if isSignedIn() && (
                       isAdmin() ||
                       (request.auth.uid == companyId &&
                        existing().userId == request.auth.uid &&
                        incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt)
                     ) && isValidCompany(incoming());
      allow delete: if isSignedIn() && (request.auth.uid == companyId || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /companyBookings/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       (incoming().status == 'Pending' || isAdmin()) &&
                       isValidCompanyBooking(incoming());
      allow update: if isSignedIn() && (
                       isAdmin() ||
                       (resource.data.userId == request.auth.uid &&
                        incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt &&
                        (incoming().status == existing().status || incoming().status == 'Cancelled') &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                     ) && isValidCompanyBooking(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       (incoming().status == 'Pending' || isAdmin()) &&
                       isValidBooking(incoming());
      allow update: if isSignedIn() && (
                       isAdmin() ||
                       (resource.data.userId == request.auth.uid &&
                        incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt &&
                        (incoming().status == existing().status || incoming().status == 'Cancelled') &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['clientName', 'contactNumber', 'preferredDate', 'preferredTime', 'location', 'notes', 'status', 'updatedAt']))
                     ) && isValidBooking(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /gallery/{itemId} {
      allow get: if isSignedIn() && (resource.data.status == 'approved' || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.status == 'approved' || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       (!('status' in incoming()) || incoming().status == 'pending' || isAdmin()) &&
                       isValidGallery(incoming());
      allow update: if isSignedIn() && (
                       isAdmin() ||
                       (resource.data.userId == request.auth.uid &&
                        incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().status == existing().status &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'thumbnailUrl', 'updatedAt']))
                     ) && isValidGallery(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /posts/{postId} {
      allow get, list: if isSignedIn() && (resource.data.status == 'published' || isAdmin());
      allow create: if isAdmin() &&
                       incoming().authorId == request.auth.uid &&
                       isValidBlogPost(incoming());
      allow update: if isAdmin() &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidBlogPost(incoming());
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidReview(incoming());
      allow update: if isSignedIn() && (
                       isAdmin() ||
                       (resource.data.userId == request.auth.uid &&
                        incoming().userId == existing().userId &&
                        incoming().bookingId == existing().bookingId &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'rating', 'comment', 'reviewerName', 'reviewerAvatarUrl', 'updatedAt'
                        ]))
                     ) && isValidReview(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() &&
                       isValidId(announcementId) &&
                       incoming().authorId == request.auth.uid &&
                       isValidAnnouncement(incoming());
      allow update: if isAdmin() &&
                       isValidId(announcementId) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidAnnouncement(incoming());
      allow delete: if isAdmin();
    }

    // Admin-only SMTP & HTML template test email dispatch requests (strictly locked to authorized admin email)
    match /adminEmailTests/{testId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(testId) && isValidAdminEmailTest(incoming());
      allow update, delete: if isAdmin();
    }

    // Authenticated-member readable, strictly Admin-configurable Wedding Package tiers (price & included services)
    match /servicePackages/{packageId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidServicePackageConfig(incoming(), packageId);
      allow delete: if isAdmin();
    }

    // Strictly Admin-only studio automation settings (automated email alert toggles & branding)
    match /studioConfig/{configId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidStudioEmailConfig(incoming(), configId);
      allow delete: if isAdmin();
    }

    // Strictly Admin-only automated email notification delivery & live alert audit log
    match /adminEmailAlerts/{alertId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(alertId) && isValidAdminEmailAlert(incoming());
      allow delete: if isAdmin();
    }

    // ========================================================================
    // PROFESSIONAL NETWORK, HIRING, OUTSOURCING & PRIVATE CHAT COLLECTIONS
    // ========================================================================

    // Private full professional registration profiles (mobile/email hidden from other users)
    match /professionals/{professionalId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(professionalId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       (!('adminNotes' in incoming()) || incoming().adminNotes == '') &&
                       isValidProfessionalProfile(incoming());
      allow update: if ((
                       isAdmin() &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt
                     ) || (
                       isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().status == existing().status &&
                       (!('adminNotes' in incoming()) || incoming().adminNotes == existing().adminNotes) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'fullName', 'mobileNumber', 'email', 'city', 'state',
                         'category', 'yearsExperience', 'skills', 'equipmentDetails',
                         'workingLocations', 'expectedCharges', 'portfolioPhotos',
                         'videoLinks', 'shortIntro', 'availabilityStatus', 'updatedAt'
                       ])
                     )) && isValidProfessionalProfile(incoming());
      allow delete: if isAdmin();
    }

    // Privacy-safe approved professional directory (NO mobileNumber/email/userId/adminNotes)
    match /publicProfessionals/{professionalId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(professionalId) && isValidPublicProfessionalProfile(incoming(), professionalId);
      allow delete: if isAdmin();
    }

    // Customer Photographer / Videographer Hiring Requests (Admin-only assignment & final confirmation)
    match /professionalHiringRequests/{requestId} {
      allow get, list: if isAdmin() || (
                          isSignedIn() && (
                            resource.data.userId == request.auth.uid ||
                            (resource.data.assignedProfessionalUid is string && resource.data.assignedProfessionalUid == request.auth.uid)
                          )
                        );
      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'Pending Admin Review' &&
                       incoming().customerAcceptance == 'pending' &&
                       (!('assignedProfessionalId' in incoming()) || incoming().assignedProfessionalId == '') &&
                       (!('assignedProfessionalUid' in incoming()) || incoming().assignedProfessionalUid == '') &&
                       (!('assignedProfessionalName' in incoming()) || incoming().assignedProfessionalName == '') &&
                       (!('adminNotes' in incoming()) || incoming().adminNotes == '') &&
                       isValidProfessionalHiringRequest(incoming());
      allow update: if ((
                       isAdmin() &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt
                     ) || (
                       // Customer may ONLY accept or decline an Admin-proposed assignment (never auto-confirm!)
                       isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status == 'Assignment Proposed' &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'customerAcceptance', 'customerResponseNote', 'status', 'updatedAt'
                       ]) &&
                       (
                         (incoming().customerAcceptance == 'accepted' && incoming().status == 'Customer Accepted') ||
                         (incoming().customerAcceptance == 'declined' && incoming().status == 'Proposal Declined')
                       )
                     ) || (
                       // Customer may cancel their own unconfirmed hiring request
                       isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status in ['Pending Admin Review', 'Assignment Proposed', 'Proposal Declined'] &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       incoming().status == 'Cancelled'
                     )) && isValidProfessionalHiringRequest(incoming());
      allow delete: if isAdmin();
    }

    // Studio & Professional Outsourcing Requests (Admin-only approval, assignment & status updates)
    match /outsourcingRequests/{requestId} {
      allow get, list: if isAdmin() || (
                          isSignedIn() && (
                            resource.data.userId == request.auth.uid ||
                            (resource.data.assignedProfessionalUid is string && resource.data.assignedProfessionalUid == request.auth.uid)
                          )
                        );
      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'Pending Admin Review' &&
                       (!('assignedProfessionalId' in incoming()) || incoming().assignedProfessionalId == '') &&
                       (!('assignedProfessionalUid' in incoming()) || incoming().assignedProfessionalUid == '') &&
                       (!('assignedProfessionalName' in incoming()) || incoming().assignedProfessionalName == '') &&
                       (!('adminNotes' in incoming()) || incoming().adminNotes == '') &&
                       isValidOutsourcingRequest(incoming());
      allow update: if ((
                       isAdmin() &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt
                     ) || (
                       isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status == 'Pending Admin Review' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       incoming().status == 'Cancelled'
                     )) && isValidOutsourcingRequest(incoming());
      allow delete: if isAdmin();
    }

    // Secure Private Messaging Threads (User <-> Admin only; zero cross-user visibility)
    match /privateChats/{chatId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.participantUid == request.auth.uid);
      allow create: if isValidId(chatId) && isValidPrivateChatThread(incoming()) && (
                       isAdmin() ||
                       (isSignedIn() && incoming().participantUid == request.auth.uid && !isChatBlocked(request.auth.uid))
                     );
      allow update: if isValidPrivateChatThread(incoming()) && (
                       isAdmin() || (
                         isSignedIn() &&
                         existing().participantUid == request.auth.uid &&
                         !isChatBlocked(request.auth.uid) &&
                         incoming().participantUid == existing().participantUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'lastMessageText', 'lastMessageAt', 'lastSenderRole',
                           'unreadByAdmin', 'unreadByUser', 'updatedAt'
                         ])
                       )
                     );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || (
                            isSignedIn() &&
                            get(/databases/$(database)/documents/privateChats/$(chatId)).data.participantUid == request.auth.uid
                          );
        allow create: if isValidId(messageId) &&
                         incoming().chatId == chatId &&
                         (!('isRead' in incoming()) || incoming().isRead == false) &&
                         !('readAt' in incoming()) &&
                         isValidPrivateChatMessage(incoming()) && (
                           (isAdmin() && incoming().senderRole == 'admin' && incoming().senderUid == request.auth.uid) ||
                           (
                             isSignedIn() &&
                             !isChatBlocked(request.auth.uid) &&
                             get(/databases/$(database)/documents/privateChats/$(chatId)).data.participantUid == request.auth.uid &&
                             incoming().senderUid == request.auth.uid &&
                             incoming().senderRole in ['customer', 'professional']
                           )
                         );
        allow update: if isValidPrivateChatMessage(incoming()) && (
                           isAdmin() || (
                             // Recipient may ONLY mark incoming Admin messages as read (cannot alter text/image/sender)
                             isSignedIn() &&
                             get(/databases/$(database)/documents/privateChats/$(chatId)).data.participantUid == request.auth.uid &&
                             existing().senderRole == 'admin' &&
                             incoming().chatId == existing().chatId &&
                             incoming().senderUid == existing().senderUid &&
                             incoming().createdAt == existing().createdAt &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt', 'readByUid', 'readByRole']) &&
                             incoming().isRead == true &&
                             incoming().readByUid == request.auth.uid &&
                             incoming().readByRole in ['customer', 'professional'] &&
                             incoming().readAt is timestamp &&
                             incoming().readAt <= request.time
                           )
                         );
        allow delete: if isAdmin();
      }
    }

    // Admin chat moderation list (block / suspend abusive users from private chat)
    match /chatBlockedUsers/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidChatBlockedUser(incoming(), userId);
      allow delete: if isAdmin();
    }

    // ========================================================================
    // STRICT CUSTOMER PRIVATE BOOKING PORTAL COLLECTIONS (UID-LOCKED)
    // ========================================================================

    // Private catalogs assigned or shared strictly with one customer UID (zero cross-customer reads)
    match /customerCatalogs/{catalogId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update: if isAdmin() && isValidId(catalogId) && isValidCustomerCatalog(incoming());
      allow delete: if isAdmin();
    }

    // Private booking slots & approval status assigned strictly to one customer UID (zero cross-customer reads)
    match /customerSlots/{slotId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update: if isAdmin() && isValidId(slotId) && isValidCustomerSlot(incoming());
      allow delete: if isAdmin();
    }
  }
}
